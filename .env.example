# Configuration Supabase pour Educ CEB Bagré
# Copiez ce fichier vers .env et remplissez avec vos propres clés

# URL de votre projet Supabase (ex: https://xyz.supabase.co)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique anonyme Supabase (visible côté client, c'est normal)
VITE_SUPABASE_ANON_KEY=votre-cle-anonyme-supabase-ici

# Circonscription par défaut
VITE_CEB_DEFAULT=BAGRÉ